# Optional. A private Solana mainnet RPC URL (for example from Helius) for faster payment detection.
# Without it Kobo uses https://api.mainnet-beta.solana.com and checks every 2 seconds.
EXPO_PUBLIC_KOBO_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key-here

# Test builds only: point the app at a local validator and a local test coin. Never set these in a real build.
# EXPO_PUBLIC_KOBO_TEST_RPC=http://127.0.0.1:8899
# EXPO_PUBLIC_KOBO_TEST_USDC=<local test mint address>
