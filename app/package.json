{
  "name": "kobo",
  "displayName": "Kobo",
  "description": "Android till for shops that get paid in digital dollars on Solana.",
  "main": "./index.js",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "build": "tsc --noEmit && npm run android:build",
    "ci": "tsc --noEmit && npm run lint:check && npm run format:check && npm run test && npm run android:build",
    "dev": "expo start --clear --dev-client --reset-cache",
    "doctor": "npx -y expo-doctor@latest",
    "e2e": "./e2e/fakewallet.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo run:ios",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "start": "expo start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/familjen-grotesk": "^0.4.2",
    "@expo/metro-runtime": "~57.0.5",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@rn-primitives/dropdown-menu": "^1.2.0",
    "@solana-program/memo": "^0.12.0",
    "@solana-program/token": "^0.15.0",
    "@solana/kit": "^7.0.0",
    "@tanstack/react-query": "^5.90.7",
    "@wallet-ui/react-native-kit": "^4.2.1",
    "expo": "~57.0.6",
    "expo-audio": "~57.0.5",
    "expo-background-task": "~57.0.21",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.5",
    "expo-dev-client": "~57.0.6",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.6",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.1",
    "js-base64": "^3.7.8",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/babel-preset": "~0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.14",
