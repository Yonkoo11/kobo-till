    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.5",
    "vitest": "^5.0.2",
    "vitest-native": "^0.9.0"
  },
  "private": true
}
