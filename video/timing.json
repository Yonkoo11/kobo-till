 "captions": {
  "hook": [
   {
    "text": "This is a shopkeeper getting paid thirty thousand naira in digital dollars.",
    "start": 0.15,
    "end": 3.93
   },
   {
    "text": "The customer scanned, the receipt printed.",
    "start": 4.33,
    "end": 6.19
   },
   {
    "text": "That's Kobo.",
    "start": 6.63,
    "end": 7.43
   }
  ],
  "problem": [
   {
    "text": "Shops in Nigeria that want dollars take them the hard way today: a wallet address pasted into WhatsApp.",
    "start": 0.39,
    "end": 5.41
   },
   {
    "text": "No amount, no confirmation, no receipt.",
    "start": 5.89,
    "end": 8.05
   }
  ],
  "till": [
   {
    "text": "Kobo is a till.",
    "start": 0.44,
    "end": 1.3
   },
   {
    "text": "You type the price in naira, like you always have.",
    "start": 1.76,
    "end": 3.7
   },
   {
    "text": "It pulls today's rate and works out the USDC itself.",
    "start": 4.04,
    "end": 6.72
   }
  ],
  "waiting": [
   {
    "text": "The customer scans with any Solana wallet.",
    "start": 0.39,
    "end": 2.29
   },
   {
    "text": "The rate is locked the moment the QR appears, so nobody argues about it later.",
    "start": 2.63,
    "end": 5.99
   }
  ],
  "paid": [
   {
    "text": "Kobo watches Solana for that exact payment, and prints the receipt.",
    "start": 0.35,
    "end": 3.51
   },
   {
    "text": "Share it to WhatsApp, with a link anyone can check on Solscan.",
    "start": 4.03,
    "end": 6.63
   }
  ],
  "detail": [
   {
    "text": "Kobo never touches the money.",
    "start": 0.39,
    "end": 1.63
   },
   {
    "text": "It goes straight to the shop's own wallet, and every receipt links to the payment on chain.",
    "start": 1.93,
    "end": 5.59
   }
  ],
  "closeday": [
   {
    "text": "At the end of the day, the shop sees every sale and closes the day.",
    "start": 0.4,
    "end": 3.38
   },
   {
    "text": "Customers paying from a Seeker phone are spotted by their Genesis Token, and lined up for an SKR reward.",
    "start": 4.14,
    "end": 8.66
   }
  ],
  "mwa": [
   {
    "text": "It connects through Mobile Wallet Adapter, so the shop's own wallet signs everything.",
    "start": 0.32,
    "end": 3.82
   }
  ],
  "end": [
   {
    "text": "Kobo.",
    "start": 0.32,
    "end": 0.76
   },
   {
    "text": "Get paid in digital dollars.",
    "start": 1.08,
